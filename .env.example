# Postgres connection string (Neon or Supabase both work — plain Postgres, no ORM)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Google Programmable Search Engine (Custom Search JSON API)
# https://programmablesearchengine.google.com/  ->  create a search engine, get the "cx" id
# https://developers.google.com/custom-search/v1/introduction -> get an API key
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# Firecrawl — web search + JS-rendering scrape. https://firecrawl.dev
# Free tier: 1000 credits/month (search = 2 credits per 10 results).
# Preferred over Google CSE, which shuts down 2027-01-01.
FIRECRAWL_API_KEY=

# Optional. "firecrawl" | "google-cse". Auto-detects from whichever key is set.
SEARCH_PROVIDER=

# OpenAI API key for extraction/categorization
OPENAI_API_KEY=
# Cheapest capable tier for bulk batch calls (extraction + categorization)
EXTRACT_MODEL=gpt-5.6-luna
# Stronger tier for the one-off curator "fetch preview" call
CURATOR_MODEL=gpt-5.6-sol

# Shared password gating /admin/curator (Basic Auth, not a real login system)
CURATOR_PASSWORD=

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` — set the
# same value in the Vercel project's environment variables so cron routes can
# reject unauthenticated public requests.
CRON_SECRET=

# ---------------------------------------------------------------- Subscribers

# WhatsApp business number in international form. The signup flow is a wa.me
# link the visitor taps to message US — their inbound message is the opt-in
# Meta requires, which is why there is no phone field anywhere in the UI.
# Leave empty and the WhatsApp option is hidden rather than rendered dead.
WHATSAPP_BUSINESS_NUMBER=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Analytics is completely
# inert when this is empty, so dev and preview builds send no traffic.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Email sending provider is NOT chosen yet (Resend / Postmark / SendGrid are
# the candidates). Nothing is built against one — subscribe/unsubscribe and
# storage work today; sending is the next step once a provider is picked.

# Alerts opt-in (components/scene/AlertsBanner.tsx). NEXT_PUBLIC_ because the
# wa.me link is built in the browser from the visitor's own selections. The
# banner does not render at all when this is empty. WhatsApp is the only
# alerts channel; the email path was removed from the UI.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Meta WhatsApp Cloud API — inbound webhook (app/api/whatsapp/webhook).
# WHATSAPP_VERIFY_TOKEN is a secret string you make up yourself; it must match
# exactly what's typed into the Callback URL setup screen in Meta's developer
# dashboard. WHATSAPP_ACCESS_TOKEN and WHATSAPP_PHONE_NUMBER_ID come from that
# same dashboard (Phone Number ID is NOT the phone number itself). WHATSAPP_
# APP_SECRET verifies the X-Hub-Signature-256 header so the webhook only
# accepts requests that actually came from Meta.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Use a Graph API version currently supported for your Meta app, including the
# leading v (for example, vXX.X). It is required rather than silently pinned in
# code so an expired version cannot fail only when the weekly cron runs.
WHATSAPP_GRAPH_API_VERSION=

# Weekly Wednesday digest. Keep disabled until scene044_weekly_digest is
# approved and `npm run whatsapp-digest -- --test` reaches delivered.
WHATSAPP_WEEKLY_TEMPLATE_NAME=scene044_weekly_digest
WHATSAPP_WEEKLY_TEMPLATE_LANGUAGE=en_US
WHATSAPP_DIGEST_ENABLED=false
WHATSAPP_TEST_RECIPIENT=

# Automatic WhatsApp subscriber -> Google Sheets sync. Create a service
# account, enable the Google Sheets API, and share the target spreadsheet with
# GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL as an Editor. The private key may use
# literal \\n sequences so it fits in a single Railway environment variable.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB_NAME=Sheet1
GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
